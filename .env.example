# Copy to .env (git-ignored) and fill in. Never commit .env.

LOG_LEVEL=INFO

# Postgres for DBOS workflows and LangGraph checkpoints (docker compose default).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/health_compass

# Traces. Local: Jaeger from docker compose (UI at http://localhost:16686).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Hosted: Langfuse Cloud instead. The header is "Basic " + base64("public_key:secret_key").
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64>
